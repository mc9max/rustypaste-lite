# ═══════════════════════════════════════════════════════════════════════════
# Rustypaste Lite — Local run reference (podman/docker).
# On Railway these become template vars (see template-editor-raw.json).
# Leave a blank AUTH_TOKEN for an OPEN public pastebin.
# ═══════════════════════════════════════════════════════════════════════════

# --- Optional: upload lock-down (single token; verified live) ────────────────
# When set, POST / (upload) requires  Authorization: Bearer <AUTH_TOKEN>;
# requests without it get 401. Reading existing pastes stays public by design.
# Blank = open public pastebin (the default).
# Generate: head -c 24 /dev/urandom | base64 | head -c 24
AUTH_TOKEN=

# --- Optional: admin-only delete (single token; verified live) ───────────────
# When set, DELETE /{id} succeeds with Authorization: Bearer <DELETE_TOKEN>.
# When blank, the DELETE endpoint is disabled entirely (returns 404) — this is
# the upstream default and the safest posture for a public instance.
DELETE_TOKEN=

# --- Optional: per-upload default TTL (dashboard variable) ──────────────────
# Not exposed in the deploy form on purpose: rustypaste panics at boot if this
# is ever set to an empty string ('expected a duration for key paste.default_expiry').
# The baked config already provides a 1h default, so a fresh install works as-is.
# To change it, set the `PASTE__DEFAULT_EXPIRY` dashboard variable to a humantime
# duration (5m, 1h, 6h, 1d) or `0` for no default expiry.
#PASTE__DEFAULT_EXPIRY=1h

# --- Local run ──────────────────────────────────────────────────────────────
# Bind to 0.0.0.0:8000 (baked into config.toml). To re-bind locally, set the
# SERVER__ADDRESS dashboard variable (humantime-free, e.g. 0.0.0.0:8080) and
# deploy again. Not exposed in the deploy form to keep the port predictable.
#SERVER__ADDRESS=0.0.0.0:8000

# Local volume for persisting pastes (Railway mounts /data automatically).
#   podman volume create rustypaste_data
#   podman run --rm -d --name rustypaste-lite \
#     --mount type=volume,source=rustypaste_data,target=/data \
#     -p 8000:8000 -e RUST_LOG=info rustypaste_lite_test
# Test a paste:
#   curl -sF 'file=@notes.txt' http://127.0.0.1:8000/
#   curl -sF 'oneshot=@secret.txt' http://127.0.0.1:8000/    # burns after 1st GET
#   curl -sF 'url=@target.txt' http://127.0.0.1:8000/  # target.txt holds a URL -> 302 to it
#   curl -sF 'protected=@secret.txt' http://127.0.0.1:8000/ # returns Password: <pw>
